# ============================================================
# Nomad Navigator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
#
# All VITE_ prefixed variables are exposed to the client bundle.
# Only put non-secret, public-facing config here.
# Secret server-side keys must NEVER use the VITE_ prefix.
# ============================================================

# --- Firebase (Client SDK — safe to expose) -----------------
# Found in Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- Gemini AI (Client SDK — restrict by HTTP referrer in Google Cloud) ----
# Found in Google Cloud Console → APIs & Services → Credentials
# ⚠️  Restrict this key to your domain in Google Cloud Console!
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Vercel Deployment (CI only — add to GitHub Secrets, not here) ----------
# VERCEL_TOKEN=          (GitHub Secret)
# VERCEL_ORG_ID=         (GitHub Secret)
# VERCEL_PROJECT_ID=     (GitHub Secret)
