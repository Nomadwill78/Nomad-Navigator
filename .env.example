# Local development only. Copy to .env.local and use a non-production Firebase
# project, Stripe sandbox resources, and a restricted Gemini key. Never commit
# .env.local or copy production user data into non-production environments.

# Firebase client configuration — use one Firebase project per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Server-only integration values. Store each value in the matching Vercel
# Development, Preview/staging, or Production environment — never in source.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
