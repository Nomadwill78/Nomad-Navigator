# Stripe API Keys
# Get your keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. From Developers > Webhooks > (your endpoint)
# in the Stripe Dashboard, or printed by `stripe listen` for local testing.
STRIPE_WEBHOOK_SECRET=

# Recurring Price IDs (price_...) for the three subscription tiers, from
# Stripe Dashboard > Products. NOT the Product IDs.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Firebase service account, used server-side (Admin SDK) so the Stripe
# webhook can write subscription/plan changes that bypass firestore.rules.
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key — paste the ENTIRE downloaded JSON file as a single-line value.
FIREBASE_SERVICE_ACCOUNT=

# --- Deploying firestore.rules ---
# Merging to GitHub does NOT publish firestore.rules by itself — see
# .github/workflows/firestore-rules.yml, which auto-deploys on push to main
# using the FIREBASE_SERVICE_ACCOUNT secret configured in this repo's GitHub
# Actions settings (Settings > Secrets and variables > Actions), same JSON
# value as above.
#
# To deploy by hand instead (`npm run deploy:rules`), the Firebase CLI reads
# credentials from GOOGLE_APPLICATION_CREDENTIALS — a *file path*, not the
# inline JSON used above:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json npm run deploy:rules
# Keep that file outside the repo; never commit a service-account JSON file.
