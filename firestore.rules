rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function hasVerifiedEmail() { return isSignedIn() && request.auth.token.email_verified == true; }
    function authEmail() { return request.auth.token.email.lower(); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function getMember(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data; }
    function isOrgMember(orgId) { return isSignedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)); }
    function hasRole(orgId, roles) { return isOrgMember(orgId) && getMember(orgId).role in roles; }
    function inviteRef() { return /databases/$(database)/documents/invitations/$(authEmail()); }
    function hasPendingInvite(orgId) {
      return hasVerifiedEmail() && exists(inviteRef()) && get(inviteRef()).data.orgId == orgId && get(inviteRef()).data.status == 'pending';
    }

    // ---- Seats ----------------------------------------------------------------------------------
    // The seat limit comes from the plan NAME, never from a stored number, so it cannot drift.
    // KEEP THIS TABLE IN STEP WITH PLAN_SEAT_LIMITS IN types.ts (tests/rules checks that they match).
    // null means unlimited. An unknown plan gets 0, so nobody new can join, instead of unlimited seats.
    function seatLimitOf(plan) {
      return plan == 'trial' ? 5 : (plan == 'starter' ? 3 : (plan == 'growth' ? 10 : (plan == 'pro' ? 25 : 0)));
    }

    function billingPath(orgId) { return /databases/$(database)/documents/organizations/$(orgId)/billing/subscription; }
    // An organization with no billing document yet is on the trial.
    function orgPlan(orgId) { return exists(billingPath(orgId)) ? get(billingPath(orgId)).data.plan : 'trial'; }
    function orgStatus(orgId) { return exists(billingPath(orgId)) ? get(billingPath(orgId)).data.status : 'trialing'; }
    // A failed payment (past_due) or an ended subscription (canceled) keeps everyone's access but adds no new members.
    function statusAllowsNewSeats(status) { return status in ['trialing', 'active']; }

    // May the organization hold `newCount` members after this write? newCount counts the person being added,
    // so the check is "<=": exactly as many members as the limit are allowed, and no more.
    function canHold(orgId, newCount) {
      let limit = seatLimitOf(orgPlan(orgId));
      return statusAllowsNewSeats(orgStatus(orgId)) && (limit == null || newCount <= limit);
    }

    function pendingInviteCount(data) { return data.get('pendingInviteCount', 0); }

    function isValidOrganization(data) {
      return data.keys().hasAll(['name', 'creatorId', 'createdAt', 'memberCount']) &&
             (data.keys().size() == 4 || (data.keys().size() == 5 && 'pendingInviteCount' in data)) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 256 &&
             (data.memberCount is int || data.memberCount is number) && data.memberCount >= 0 &&
             pendingInviteCount(data) is int && pendingInviteCount(data) >= 0;
    }

    function isValidBilling(data) {
      return data.keys().hasAll(['plan', 'status', 'seatLimit', 'updatedAt']) &&
             data.keys().size() == 4 && data.plan is string && data.status is string &&
             ((data.seatLimit is int) || data.seatLimit == null);
    }

    function isValidRole(role) { return role in ['admin', 'grant_coordinator', 'impact_analyst', 'compliance_officer', 'data_entry', 'viewer']; }

    function isValidOrgMember(data) {
      return data.keys().hasAll(['userId', 'email', 'role', 'joinedAt']) && data.keys().size() == 4 &&
             data.userId is string && data.email is string && data.email.size() > 0 && isValidRole(data.role);
    }

    function isValidGrant(data, grantId) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 300 &&
             data.funder is string && data.funder.size() > 0 && data.funder.size() < 300 &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000000 &&
             (!('spentAmount' in data) || (data.spentAmount is number && data.spentAmount >= 0 && data.spentAmount <= 1000000000)) &&
             data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.status in ['active', 'pending', 'completed'] && data.kpis is list && data.kpis.size() <= 200 &&
             (!('subgrantees' in data) || (data.subgrantees is list && data.subgrantees.size() <= 200)) && data.id == grantId;
    }

    function isValidProgram(data, programId) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 300 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('populationServed' in data) || (data.populationServed is string && data.populationServed.size() <= 1000)) &&
             (!('startDate' in data) || (data.startDate is string && (data.startDate == '' || data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))) &&
             (!('endDate' in data) || (data.endDate is string && (data.endDate == '' || data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))) &&
             (!('budgetNeed' in data) || (data.budgetNeed is number && data.budgetNeed >= 0 && data.budgetNeed <= 1000000000)) &&
             data.id == programId;
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['email', 'orgId', 'orgName', 'role', 'invitedBy', 'invitedByEmail', 'status', 'createdAt']) &&
             data.keys().size() == 8 && data.email is string && data.email.size() > 3 && data.email.size() < 200 &&
             data.orgId is string && data.orgId.size() > 0 && data.orgName is string && data.orgName.size() < 256 &&
             isValidRole(data.role) && data.invitedBy == request.auth.uid && data.status == 'pending';
    }

    match /organizations/{orgId} {
      allow get: if isOrgMember(orgId) || hasPendingInvite(orgId);
      // A new organization starts with exactly one member, its creator, added in the same commit.
      allow create: if isSignedIn() && isValidOrganization(incoming()) && incoming().creatorId == request.auth.uid && isValidId(orgId) &&
        incoming().memberCount == 1 && pendingInviteCount(incoming()) == 0 &&
        existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
      // memberCount is a counter that only moves with a real membership change:
      //  - an admin can edit the organization but can NEVER set memberCount (it must stay as it is);
      //  - an invitee can add exactly 1, and only in the same commit that creates their own membership;
      //  - removals go through the server (which recounts the members), so no client can lower it.
      allow update: if
        // Ordinary admin edits cannot manipulate either seat counter.
        (hasRole(orgId, ['admin']) && isValidOrganization(incoming()) && incoming().creatorId == existing().creatorId &&
         incoming().memberCount == existing().memberCount &&
         pendingInviteCount(incoming()) == pendingInviteCount(existing()))
        ||
        // Creating an invitation reserves one seat in the same atomic commit.
        (hasRole(orgId, ['admin'])) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['pendingInviteCount']) &&
         pendingInviteCount(incoming()) == pendingInviteCount(existing()) + 1 &&
         canHold(orgId, existing().memberCount + pendingInviteCount(incoming())))
        ||
        // Accepting an already-reserved invitation transfers one pending seat to one active member.
        (hasRole(orgId, ['admin']) && incoming().diff(existing()).affectedKeys().hasOnly(['pendingInviteCount']) &&
         pendingInviteCount(incoming()) == pendingInviteCount(existing()) - 1)
        ||
        (hasPendingInvite(orgId) && incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'pendingInviteCount']) &&
         incoming().memberCount == existing().memberCount + 1 &&
         pendingInviteCount(incoming()) == pendingInviteCount(existing()) - 1 &&
         !exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         !existsAfter(inviteRef()));

      match /members/{userId} {
        allow read: if isOrgMember(orgId);
        // Only two ways in, and only for yourself:
        //  1. you created this organization (it does not exist yet; it and you are created together as its first admin), or
        //  2. you hold a pending invitation, and the organization's memberCount goes up by exactly 1 in the same commit
        //     while the seat limit still has room. (An admin cannot add members directly.)
        allow create: if isValidOrgMember(incoming()) && incoming().userId == userId && userId == request.auth.uid &&
          (
            (!exists(/databases/$(database)/documents/organizations/$(orgId)) &&
             getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid &&
             getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.memberCount == 1 &&
             incoming().role == 'admin')
            ||
            (hasPendingInvite(orgId) && incoming().role == get(inviteRef()).data.role && incoming().email.lower() == authEmail() &&
             getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.memberCount ==
               get(/databases/$(database)/documents/organizations/$(orgId)).data.memberCount + 1 &&
             pendingInviteCount(getAfter(/databases/$(database)/documents/organizations/$(orgId)).data) ==
               pendingInviteCount(get(/databases/$(database)/documents/organizations/$(orgId)).data) - 1 &&
             !existsAfter(inviteRef()))
          );
        // Roles can change, but not your own, and not the owner's: an organization always keeps its owner as an admin.
        allow update: if hasRole(orgId, ['admin']) && isValidOrgMember(incoming()) && incoming().userId == existing().userId &&
          userId != request.auth.uid && userId != get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId;
        // Removing a member also lowers memberCount, which a client cannot do safely, so removal is done by the
        // server (POST /api/remove-member), which deletes the member and recounts in one transaction.
        allow delete: if false;
      }

      match /billing/{docId} {
        // A pending invitee may read the plan (the app checks it before joining and says why a seat is not free).
        allow get: if isOrgMember(orgId) || hasPendingInvite(orgId);
        allow list: if false;
        allow create: if docId == 'subscription' && isSignedIn() &&
                         getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid &&
                         isValidBilling(incoming()) && incoming().plan == 'trial' && incoming().seatLimit == 5;
        allow update, delete: if false;
      }

      match /grants/{grantId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update: if hasRole(orgId, ['admin', 'grant_coordinator']) && isValidGrant(incoming(), grantId);
        allow delete: if hasRole(orgId, ['admin']);
      }

      match /settings/{docId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update: if docId == 'general' && hasRole(orgId, ['admin']) &&
          incoming().keys().hasOnly(['fiscalYearStartMonth']) &&
          incoming().fiscalYearStartMonth is int && incoming().fiscalYearStartMonth >= 1 && incoming().fiscalYearStartMonth <= 12;
        allow delete: if false;
      }

      match /programs/{programId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update: if hasRole(orgId, ['admin', 'grant_coordinator']) && isValidProgram(incoming(), programId);
        allow delete: if hasRole(orgId, ['admin']);
      }

      match /metrics/{metricId} {
        allow get, list: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['admin', 'impact_analyst', 'data_entry']);
      }
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
    }

    match /invitations/{inviteEmail} {
      allow get: if isSignedIn() && (inviteEmail == authEmail() || hasRole(resource.data.orgId, ['admin']));
      allow list: if isSignedIn() && hasRole(resource.data.orgId, ['admin']);
      allow create: if !exists(/databases/$(database)/documents/invitations/$(inviteEmail)) &&
                       isValidInvitation(incoming()) && inviteEmail == incoming().email &&
                       hasRole(incoming().orgId, ['admin']) &&
                       pendingInviteCount(getAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)).data) ==
                         pendingInviteCount(get(/databases/$(database)/documents/organizations/$(incoming().orgId)).data) + 1 &&
                       canHold(incoming().orgId,
                         get(/databases/$(database)/documents/organizations/$(incoming().orgId)).data.memberCount +
                         pendingInviteCount(getAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)).data));
      allow update: if false;
      // Admin revocation releases one reserved seat; invite acceptance transfers the reservation to membership.
      allow delete: if
        (hasRole(resource.data.orgId, ['admin']) &&
         pendingInviteCount(getAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data) ==
           pendingInviteCount(get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data) - 1)
        ||
        (hasVerifiedEmail() && inviteEmail == authEmail() &&
         existsAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid)) &&
         getAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.memberCount ==
           get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.memberCount + 1 &&
         pendingInviteCount(getAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data) ==
           pendingInviteCount(get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data) - 1);
    }

    match /trial_signups/{signupId} {
      allow create: if incoming().keys().hasOnly(['name', 'email', 'org', 'useCase', 'status', 'createdAt']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() < 120 &&
        incoming().email is string && incoming().email.size() > 3 && incoming().email.size() < 200 &&
        incoming().org is string && incoming().org.size() > 0 && incoming().org.size() < 200 &&
        incoming().useCase is string && incoming().useCase.size() < 2000 && incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
