rules_version = '2';

// ============================================================
// Nomad Navigator — Firestore Security Rules  (PRODUCTION)
// ============================================================
// Deployed via: firebase deploy --only firestore:rules
// Last reviewed: 2026-05-17
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------

    // True if the request comes from a signed-in user
    function isAuthenticated() {
      return request.auth != null;
    }

    // True if the requesting user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True if the incoming data field equals the authenticated user's UID
    function ownsField(field) {
      return isAuthenticated() && request.resource.data[field] == request.auth.uid;
    }

    // ----------------------------------------------------------
    // Users collection
    // /users/{userId}
    // ----------------------------------------------------------
    match /users/{userId} {
      // Anyone authenticated can read any user profile
      allow read: if isAuthenticated();

      // Only the owner can create or update their own profile
      allow create: if isOwner(userId) && ownsField('uid');
      allow update: if isOwner(userId);

      // Prevent user deletion through the client SDK
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // Organizations collection
    // /organizations/{orgId}
    // ----------------------------------------------------------
    match /organizations/{orgId} {
      // Members can read
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.memberIds;

      // Admin members can create / update
      allow create: if isAuthenticated() && ownsField('createdBy');
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.adminIds;

      allow delete: if false;

      // Nested subcollections inherit org membership checks
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberIds;

        allow write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberIds;
      }
    }

    // ----------------------------------------------------------
    // Assessments collection
    // /assessments/{assessmentId}
    // ----------------------------------------------------------
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         request.auth.uid in resource.data.sharedWith);

      allow create: if isAuthenticated() && ownsField('createdBy');

      allow update: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;
    }

    // ----------------------------------------------------------
    // Reports collection
    // /reports/{reportId}
    // ----------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.sharedWith);

      allow create: if isAuthenticated() && ownsField('ownerId');

      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ----------------------------------------------------------
    // Deny all other paths by default
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
